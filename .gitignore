# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/*.egg-info/

# Local build noise (keep prebuilt/ intentionally)
**/build/
eche_source/dist/
eche_installer_source/build/
eche_installer_source/dist/
eche_installer/build/

# Runtime / secrets (never publish)
**/.env
**/.env.*
**/config/settings.json
**/config/secrets.dpapi.json
**/config/*.dpapi.json
**/cookies/
**/logs/
**/context/
**/memories/
**/.eche_*
**/.echelon_*
**/*.dpapi

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Old names / trash
echelon_*/
**/__trash*/

# Portable app runtime + freeze output (local only; build with eche_source/BUILD.bat)
# Do not commit frozen binaries / _internal trees — installer is the ready-to-run path.
eche/Eche.exe
eche/_internal/
eche/config/
eche/cookies/
eche/logs/
eche/context/
eche/memories/
eche/dist/
eche/*.lock
eche/**/opted_in.json
eche/**/gui.lock
eche/**/settings.json
eche/**/secrets*
eche/install.json
eche/icon.ico
eche/icon.png
eche_source/Uninstall.exe
eche_source/START_HERE.txt
eche_source/gui.lock
eche_installer_source/final/

# Keep installer dist EXE for convenience (optional)
# eche_installer/dist/ is tracked for local convenience; strip secrets only
